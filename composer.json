{
    "name": "bkpsdm/ui-kit",
    "description": "BKPSDM UI Kit — design system admin theme untuk Laravel (Blade) & Nuxt, selaras INA Digital Design System. Framework-agnostic: CSS custom properties + vanilla JS, tanpa dependensi build.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "nuxt",
        "vue",
        "ui-kit",
        "design-system",
        "ina-digital",
        "idss",
        "admin",
        "dashboard",
        "blade",
        "bkpsdm"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Bkpsdm\\UiKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bkpsdm\\UiKit\\BkpsdmUiKitServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
